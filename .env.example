OPENAI_API_KEY=sk-...
QUESTION_MODEL=gpt-5.1
REALTIME_MODEL=gpt-realtime-2.1
NEXT_PUBLIC_EXAM_DATE=2026-08-23

# Sentry (optional — everything is inert when the DSN is unset)
# Server SDK reads SENTRY_DSN at runtime; restart is enough for a change to take effect.
SENTRY_DSN=
# Client SDK reads NEXT_PUBLIC_SENTRY_DSN; Next.js inlines it at build time,
# so a change requires a rebuild.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Which deployed instance this process is (e.g. prod, demo). Used for Sentry tags.
# Set to 'demo' for the demo pm2 process; when unset it defaults to 'prod'.
MCAT_INSTANCE=
