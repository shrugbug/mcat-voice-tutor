OPENAI_API_KEY=sk-...
QUESTION_MODEL=gpt-5.1
REALTIME_MODEL=gpt-realtime-2.1
NEXT_PUBLIC_EXAM_DATE=2026-08-23
# Landing-page personalization. Both are inlined at build time, so a change needs a rebuild.
# Unset falls back to the in-source defaults; the demo vhost overrides both by hostname.
NEXT_PUBLIC_STUDENT_NAME=
NEXT_PUBLIC_STUDENT_FILE_LABEL=

# Sentry (optional — everything is inert when the DSN is unset)
# Server SDK reads SENTRY_DSN at runtime; restart is enough for a change to take effect.
SENTRY_DSN=
# Client SDK reads NEXT_PUBLIC_SENTRY_DSN; Next.js inlines it at build time,
# so a change requires a rebuild.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Separate org:ci-scoped token for the Next.js build-time source-map upload
# (next.config.ts); falls back to SENTRY_AUTH_TOKEN if unset. See SENTRY-VPS-SETUP.sh.
SENTRY_CI_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Which deployed instance this process is (e.g. prod, demo). Used for Sentry tags.
# Set to 'demo' for the demo pm2 process; when unset it defaults to 'prod'.
MCAT_INSTANCE=

# Per student session per minute; per client IP per ten minutes, respectively.
TOOL_RATE_LIMIT=30
SESSION_RATE_LIMIT=10
# Enable ONLY after verifying Node is reachable solely through trusted nginx.
# nginx must overwrite X-Forwarded-For with $remote_addr, or append the real peer.
# We use the rightmost IP (single trusted hop), never the caller's leftmost value.
TRUST_PROXY=false
# Limits and signed rate-limit cookies reset on restart/deploy, per process.
# Expired limiter entries are removed on subsequent requests. Cookies last 24h.
# Cookies are not authentication. Missing/invalid cookies use the IP tool bucket.
# Without trusted proxy mode, unknown IPs share a conservative fallback bucket.
# Shared NATs share the session-mint allowance; use a shared store for multi-process.
